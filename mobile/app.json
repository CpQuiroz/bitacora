{
  "expo": {
    "name": "Bitácora",
    "slug": "bitacora",
    "scheme": "bitacora",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e4e8c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.transportesitineris.bitacora",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cl.transportesitineris.bitacora",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#1e4e8c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Bitácora necesita acceso a tus fotos para adjuntarlas a un trabajo.",
          "cameraPermission": "Bitácora necesita la cámara para tomar fotos de un trabajo."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Bitácora registra tu ubicación al hacer check-in y check-out de un trabajo."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Bitácora usa Face ID para desbloquear la app."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "7c69b173-8ec3-4fe2-9988-b3efce797683"
      }
    },
    "owner": "cpquiroz"
  }
}
