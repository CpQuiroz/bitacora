PORT=8080
WEB_URL=http://localhost:3000

# Supabase (Proyecto → Settings → API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Storage (Fase 1: endpoint S3 de Supabase Storage.
# Proyecto → Settings → Storage → S3 Connection)
STORAGE_ENDPOINT=https://TU-PROYECTO.supabase.co/storage/v1/s3
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=fotos-trabajos

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Llave maestra para cifrar las credenciales que cada empresa guarda en
# Configuración > Integraciones (AES-256-GCM). Generarla una sola vez con:
#   openssl rand -base64 32
# Guárdala en un gestor de secretos aparte del repo — si se pierde, las
# credenciales ya guardadas no se pueden volver a descifrar.
INTEGRACIONES_ENCRYPTION_KEY=

# Llave para firmar los tokens de sesión del Portal de Cliente. Generarla
# una sola vez con: openssl rand -base64 32
PORTAL_TOKEN_SECRET=

# Opcionales — sin esto, el envío de la encuesta de satisfacción
# post-servicio se omite en silencio (console.resend.com → API Keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Opcionales — bot de WhatsApp para choferes (módulo Viajes). Sin
# esto, el webhook responde 200 pero no procesa nada.
# developers.facebook.com → tu app → WhatsApp → API Setup:
#   WHATSAPP_ACCESS_TOKEN: el "Temporary access token" (o uno
#     permanente de un system user, para producción)
#   WHATSAPP_PHONE_NUMBER_ID: "Phone number ID" de esa misma pantalla
#   WHATSAPP_VERIFY_TOKEN: un texto que TÚ inventas — se pone también
#     en Meta al configurar el webhook (Configuration → Webhook)
#   WHATSAPP_APP_SECRET: tu app → Settings → Basic → "App secret"
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
