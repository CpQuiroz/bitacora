PORT=8080
WEB_URL=http://localhost:3000
# Orígenes permitidos por CORS, separados por coma. Sin esta variable,
# el backend solo acepta requests desde http://localhost:3000 (dev).
# En producción: ALLOWED_ORIGINS=https://app.tudominio.cl,https://portal.tudominio.cl
ALLOWED_ORIGINS=

# Supabase (Proyecto → Settings → API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Storage (Fase 1: endpoint S3 de Supabase Storage.
# Proyecto → Settings → Storage → S3 Connection)
STORAGE_ENDPOINT=https://TU-PROYECTO.supabase.co/storage/v1/s3
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=fotos-trabajos

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Llave maestra para cifrar las credenciales que cada empresa guarda en
# Configuración > Integraciones (AES-256-GCM). Generarla una sola vez con:
#   openssl rand -base64 32
# Guárdala en un gestor de secretos aparte del repo — si se pierde, las
# credenciales ya guardadas no se pueden volver a descifrar.
INTEGRACIONES_ENCRYPTION_KEY=

# Llave para firmar los tokens de sesión del Portal de Cliente. Generarla
# una sola vez con: openssl rand -base64 32
PORTAL_TOKEN_SECRET=

# Panel de Super-Admin (identidad de plataforma, separada de todo lo
# demás). Generar cada una una sola vez con: openssl rand -base64 32
#   SUPERADMIN_TOKEN_SECRET: firma los tokens de sesión (HMAC-SHA256)
#   SUPERADMIN_ENCRYPTION_KEY: cifra el secreto TOTP en reposo — distinta
#     de INTEGRACIONES_ENCRYPTION_KEY a propósito
SUPERADMIN_TOKEN_SECRET=
SUPERADMIN_ENCRYPTION_KEY=

# 2FA de usuarios normales (TOTP o código por correo, ver routes/mfa.ts
# y routes/authLogin.ts). Generar con: openssl rand -base64 32
USUARIOS_MFA_ENCRYPTION_KEY=

# Opcional — reporte de errores a Sentry (sentry.io → proyecto Node →
# Client Keys). Sin DSN el SDK queda inerte. SENTRY_ENVIRONMENT: p.ej.
# "production" en Render, "development" local.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Opcionales — sin esto, el envío de la encuesta de satisfacción
# post-servicio se omite en silencio (console.resend.com → API Keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Opcionales — bot de WhatsApp para choferes (módulo Viajes). Sin
# esto, el webhook responde 200 pero no procesa nada.
# developers.facebook.com → tu app → WhatsApp → API Setup:
#   WHATSAPP_ACCESS_TOKEN: el "Temporary access token" (o uno
#     permanente de un system user, para producción)
#   WHATSAPP_PHONE_NUMBER_ID: "Phone number ID" de esa misma pantalla
#   WHATSAPP_VERIFY_TOKEN: un texto que TÚ inventas — se pone también
#     en Meta al configurar el webhook (Configuration → Webhook)
#   WHATSAPP_APP_SECRET: tu app → Settings → Basic → "App secret"
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Opcionales — suscripción B2B (cobro recurrente a empresas clientes).
# sandbox.flow.cl → Mis Datos → Integraciones (Seguridad) mientras se
# prueba. FLOW_API_URL apunta a sandbox por defecto — cambiar a
# https://www.flow.cl/api solo en producción, con su propio par de claves.
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_URL=https://sandbox.flow.cl/api
# El Plan mensual se crea una sola vez desde el panel de Flow (sandbox.flow.cl
# → Planes de Suscripción) — no existe API para crear planes. Pegar acá el id.
FLOW_PLAN_ID_BASICO=
FLOW_PLAN_ID_PRO=
